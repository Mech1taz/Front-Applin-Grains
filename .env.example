# --- Conexión (el proxy de Vite reenvía /api al BFF) ---
BFF_URL=http://IP_PUBLICA_EC2:8088
VITE_API_URL=/api

# --- Login Microsoft ---
VITE_AUTH_ENABLED=true
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUTHORITY=common
VITE_API_SCOPE=api://CLIENT_ID_DEL_API/access_as_user
VITE_ADMIN_ROLE=Admin
# Solo UI, mientras no exista el rol Admin en Azure (correos separados por coma)
VITE_ADMIN_EMAILS=
